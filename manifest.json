{
  "manifest_version": 3,
  "name": "Folia \u2014 AI Bookmark Manager",
  "version": "1.0.0",
  "description": "Save bookmarks from any site. AI auto-classifies into folders by priority. Hover capture with per-site controls.",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Folia \u2014 Save Bookmark"
  },
  "background": {
    "scripts": [
      "config.js",
      "background/background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "Alt+F"
      },
      "description": "Open Folia Dashboard"
    },
    "save-bookmark": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Quick save current page to Folia"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "folia@ai-bookmarks.ext",
      "strict_min_version": "109.0"
    }
  }
}